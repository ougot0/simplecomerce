# --- Supabase (nouveau projet dédié à Simple Commerce) — Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Clé « service_role » : uniquement côté serveur, jamais dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Adresse publique du portail (liens des e-mails)
NEXT_PUBLIC_SITE_URL=https://portail.mon-domaine.fr

# --- Secrets du portail — générer avec : openssl rand -base64 32
CREDENTIALS_KEY_V1=
SESSION_SECRET=

# --- E-mails d'invitation (facultatif : sans eux, le lien s'affiche pour être copié)
RESEND_API_KEY=
MAIL_FROM="Simple Commerce <portail@mon-domaine.fr>"

# --- Démonstration locale sans aucun compte : SIMPLECOMMERCE_MODE=demo
